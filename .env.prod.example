# Database
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=xfin
MYSQL_USER=xfin_user
MYSQL_PASSWORD=change_me_db_password

# Prisma / backend database URL (the backend will use mysql host from docker network)
# Example: mysql://xfin_user:change_me_db_password@mysql:3306/xfin
DATABASE_URL=mysql://MYSQL_USER:MYSQL_PASSWORD@mysql:3306/xfin

# JWT secrets
JWT_SECRET=change_me_jwt_secret
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret

# Frontend
VITE_API_URL=/api

# Optional
ENABLE_SEED=false
